@page "/journal"
@inherits LayoutComponentBase

<div class="journal-layout">
    <section class="journal-header-section">
        <div class="journal-header-container">
            <div class="journal-title-wrapper">
                <h1 class="journal-main-title">Journal Entry</h1>
                <div class="journal-meta-data">
                    <img src="images/journal-calender.png" alt="Calendar Icon" class="calendar-icon-small" />
                    <span class="journal-date-display">Journal Entry for 21 December 2025</span>
                </div>
            </div>
        </div>
    </section>

    <section class="journal-content-section">
        <div class="journal-workspace-layout">
            <div class="journal-editor-panel">
                <div class="journal-editor-surface">
                    <div class="journal-editor-header-area">
                        <div class="journal-title-input-wrapper">
                            <input type="text"
                                   class="journal-headline-field"
                                   placeholder="Give your day a headline..."
                                   value="Give your day a headline..." />
                            <div class="journal-progress-indicator">
                                <span class="progress-counter">0/100</span>
                            </div>
                        </div>
                    </div>

                    <div class="journal-editor-toolbar">
                        <div class="editor-tool-section heading-styles">
                            <button class="editor-style-button">H1</button>
                            <button class="editor-style-button">H2</button>
                            <button class="editor-style-button">H3</button>
                        </div>
                        <div class="toolbar-divider-line"></div>
                        <div class="editor-tool-section text-formatting">
                            <button class="editor-icon-button">
                                <img src="images/bold-icon.png" alt="Bold" />
                            </button>
                            <button class="editor-icon-button">
                                <img src="images/italic-icon.png" alt="Italic" />
                            </button>
                            <button class="editor-icon-button">
                                <img src="images/underline-icon.png" alt="Underline" />
                            </button>
                        </div>
                        <div class="toolbar-divider-line"></div>
                        <div class="editor-tool-section list-tools">
                            <button class="editor-icon-button">
                                <img src="images/unordered-list.png" alt="Unordered List" />
                            </button>
                            <button class="editor-icon-button">
                                <img src="images/orderlist.png" alt="Ordered List" />
                            </button>
                        </div>
                        <div class="toolbar-divider-line"></div>
                        <div class="editor-tool-section attachment-tools">
                            <button class="editor-icon-button attachment-button">
                                <img src="images/attach-icon.png" alt="Attach" />
                            </button>
                            <button class="editor-icon-button">
                                <img src="images/image-icon.png" alt="Add Image" />
                            </button>
                        </div>
                    </div>

                    <div class="journal-editor-body-area">
                        <textarea class="journal-main-textarea"
                                  placeholder="Start writing your thoughts here"></textarea>
                    </div>
                </div>

                <div class="journal-editor-footer-area">
                    <div class="editor-statistics">
                        <span class="editor-stat-item">WORDS: 0</span>
                        <span class="editor-stat-item">CHARACTERS: 0</span>
                    </div>
                </div>
            </div>

            <aside class="journal-sidebar-panel">
                <div class="journal-sidebar-card">
                    <div class="sidebar-card-header">
                        <div class="sidebar-icon-holder">
                            <img src="images/mood-icon.png" alt="Mood Icon" class="sidebar-header-icon" />
                        </div>
                        <h3 class="sidebar-card-heading">Mood Tracking</h3>
                    </div>

                    <div class="sidebar-form-element">
                        <label class="sidebar-form-label">Primary Mood <span class="required-indicator">*</span></label>
                        <div class="sidebar-select-field">
                            <span class="select-placeholder-text">Select how you feel</span>
                            <img src="images/arrow-down.png" alt="Arrow" class="select-arrow-icon" />
                        </div>
                    </div>

                    <div class="sidebar-form-element mood-secondary-section">
                        <div class="mood-label-row">
                            <label class="sidebar-form-label">Secondary Mood <span class="required-indicator">*</span></label>
                            <span class="mood-hint-text">Max 2</span>
                        </div>
                        <div class="mood-tags-grid">
                            <div class="mood-tags-row">
                                <div class="mood-tag-item selected-mood">Productive</div>
                                <div class="mood-tag-item">Distracted</div>
                                <div class="mood-tag-item">Focused</div>
                            </div>
                            <div class="mood-tags-row">
                                <div class="mood-tag-item outline-mood">Lonely</div>
                                <div class="mood-tag-item">Sleepy</div>
                                <div class="mood-tag-item">Curious</div>
                            </div>
                        </div>

                        <div class="mood-input-row">
                            <input type="text" class="mood-input-field" placeholder="Enter Secondary Mood" />
                            <button class="mood-add-button">Add</button>
                        </div>
                    </div>
                </div>

                <div class="journal-sidebar-card">
                    <div class="sidebar-card-header">
                        <div class="sidebar-icon-holder">
                            <img src="images/Categorization-icon.png" alt="Tag Icon" class="sidebar-header-icon-svg" />
                        </div>
                        <h3 class="sidebar-card-heading">Categorization</h3>
                    </div>

                    <div class="sidebar-form-element">
                        <label class="sidebar-form-label">Category <span class="required-indicator">*</span></label>
                        <div class="sidebar-select-field">
                            <span class="select-placeholder-text">Select Category</span>
                            <img src="images/arrow-down.png" alt="Arrow" class="select-arrow-icon" />
                        </div>
                    </div>

                    <div class="sidebar-form-element">
                        <label class="sidebar-form-label">Tags <span class="required-indicator">*</span></label>
                        <div class="sidebar-select-field">
                            <span class="select-placeholder-text">Select from recent tags</span>
                            <img src="images/arrow-down.png" alt="Arrow" class="select-arrow-icon" />
                        </div>

                        <div class="tag-input-row">
                            <input type="text" class="tag-input-field" placeholder="New tag name" />
                            <button class="tag-add-button">Add</button>
                        </div>

                        <div class="selected-tags-container">
                            <div class="tag-bubble">
                                <span>#milestone</span>
                                <button class="tag-remove-button">
                                    <img src="images/close-icon.png" alt="Remove" />
                                </button>
                            </div>
                            <div class="tag-bubble">
                                <span>#holiday</span>
                                <button class="tag-remove-button">
                                    <img src="images/close-icon.png" alt="Remove" />
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="journal-sidebar-card">
                    <h3 class="sidebar-card-heading no-icon-heading">System Information</h3>
                    <div class="system-info-row">
                        <span class="system-info-label">Created At:</span>
                        <div class="system-info-values">
                            <span class="system-info-value">12 December, 2025</span>
                            <span class="system-info-value">9:11 AM</span>
                        </div>
                    </div>
                    <div class="system-info-row">
                        <span class="system-info-label">Last Update</span>
                        <span class="system-info-value">Just Now</span>
                    </div>
                    <div class="system-info-row">
                        <span class="system-info-label">Total Word Count</span>
                        <span class="system-info-value">1200 words</span>
                    </div>
                </div>

                <div class="journal-actions-container">
                    <button class="journal-primary-action full-width-action">
                        <div class="action-button-content">
                            <img src="images/save-icon.png" alt="Save" />
                            <span>Save Entry</span>
                        </div>
                    </button>

                    <div class="journal-secondary-actions">
                        <button class="journal-secondary-button">Cancel</button>
                        <div class="action-divider-vertical"></div>
                        <button class="journal-secondary-button delete-action">
                            <img src="images/delete-icon.png" alt="Delete" />
                            <span>Delete</span>
                        </button>
                    </div>
                </div>
            </aside>
        </div>
    </section>
</div>