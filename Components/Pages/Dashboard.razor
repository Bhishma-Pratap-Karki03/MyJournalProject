@page "/dashboard"
@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<div class="dashboard">
    <div class="dashboard-content">
        <!-- Hero Section -->
        <div class="dashboard-hero">
            <h1 class="page-title">Dashboard Overview</h1>
            <p class="page-subtitle">Welcome back, Nissan. Here is your activity summary.</p>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <!-- Card 1 -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">CURRENT STREAK</span>
                    <div class="stat-value-group">
                        <span class="stat-number">20</span>
                        <span class="stat-unit">Days</span>
                    </div>
                </div>
                <img src="images/fire-icon.svg" alt="Fire Icon" class="stat-icon">
            </div>

            <!-- Card 2 -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">LONGEST STREAK</span>
                    <div class="stat-value-group">
                        <span class="stat-number">40</span>
                        <span class="stat-unit">Days</span>
                    </div>
                </div>
                <img src="images/trophy-icon.svg" alt="Trophy Icon" class="stat-icon">
            </div>

            <!-- Card 3 -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">MISSED DAYS</span>
                    <div class="stat-value-group">
                        <span class="stat-number">3</span>
                        <span class="stat-unit">This Month</span>
                    </div>
                </div>
                <img src="images/calendar-icon.svg" alt="Calendar Icon" class="stat-icon">
            </div>

            <!-- Card 4 -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">CURRENT MOOD</span>
                    <div class="mood-badge">
                        <div class="mood-icon-wrapper">
                            <img src="images/happy-icon.svg" alt="Happy" class="mood-icon">
                        </div>
                        <span class="mood-text">Happy</span>
                    </div>
                </div>
                <img src="images/smiley.png" alt="Smiley" class="stat-icon smiley-icon">
            </div>
        </div>

        <!-- Charts Grid -->
        <div class="charts-grid">
            <!-- Mood Distribution Chart Card -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3 class="chart-title">Mood Distribution</h3>
                    <div class="chart-dropdown">
                        <select id="moodPeriod" @onchange="UpdateMoodChart">
                            <option value="7">Last 7 Days</option>
                            <option value="30" selected>Last Month</option>
                            <option value="120">Last 4 Months</option>
                        </select>
                    </div>
                </div>
                <div class="chart-container">
                    <canvas id="moodChart" width="400" height="400"></canvas>
                </div>
            </div>

            <!-- Word Count Trend Chart Card -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3 class="chart-title">Word Count Trend</h3>
                    <div class="chart-dropdown">
                        <select id="wordCountPeriod" @onchange="UpdateWordCountChart">
                            <option value="7" selected>Last 7 Days</option>
                            <option value="30">Last Month</option>
                            <option value="120">Last 4 Months</option>
                        </select>
                    </div>
                </div>
                <div class="chart-container">
                    <canvas id="wordCountChart" width="400" height="400"></canvas>
                </div>
            </div>
        </div>

        <!-- Widgets Grid -->
        <div class="widgets-grid">
            <!-- Most Used Tags -->
            <div class="widget-card tags-widget">
                <h3 class="widget-title">Most Used Tags</h3>
                <div class="tags-list">
                    <div class="tag-item">
                        <div class="tag-info">
                            <span class="tag-name">#Research</span>
                            <span class="tag-count">12 entries</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width: 100%;"></div>
                        </div>
                    </div>
                    <div class="tag-item">
                        <div class="tag-info">
                            <span class="tag-name">#Personal</span>
                            <span class="tag-count">8 entries</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width: 66%;"></div>
                        </div>
                    </div>
                    <div class="tag-item">
                        <div class="tag-info">
                            <span class="tag-name">#Ideas</span>
                            <span class="tag-count">5 entries</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width: 41%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Keep it up -->
            <div class="widget-card motivation-widget">
                <div class="motivation-content">
                    <img src="images/write-icon.png" alt="Write Icon" class="motivation-icon">
                    <h3 class="motivation-title">Keep it up!</h3>
                    <p class="motivation-text">Be consistent. Keep posting daily. Break your own streak record</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isInitialized = false;
    private IJSObjectReference? chartModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            await InitializeCharts();
            isInitialized = true;
        }
    }

    private async Task InitializeCharts()
    {
        // Import Chart.js module
        chartModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");

        // Initialize both charts
        await InitializeMoodChart();
        await InitializeWordCountChart();
    }

    private async Task InitializeMoodChart()
    {
        if (chartModule != null)
        {
            await chartModule.InvokeVoidAsync("createMoodChart",
                new
                {
                    positive = 60,
                    neutral = 30,
                    negative = 10
                });
        }
    }

    private async Task InitializeWordCountChart()
    {
        if (chartModule != null)
        {
            // Static data for last 7 days
            var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
            var wordCounts = new[] { 450, 325, 280, 500, 420, 380, 550 };

            await chartModule.InvokeVoidAsync("createWordCountChart",
                new
                {
                    labels = days,
                    data = wordCounts
                });
        }
    }

    private async Task UpdateMoodChart(ChangeEventArgs e)
    {
        if (chartModule != null)
        {
            var period = e.Value?.ToString();

            // Static data based on period
            var moodData = period switch
            {
                "7" => new { positive = 65, neutral = 25, negative = 10 }, // Last 7 days
                "30" => new { positive = 60, neutral = 30, negative = 10 }, // Last month
                "120" => new { positive = 55, neutral = 35, negative = 10 }, // Last 4 months
                _ => new { positive = 60, neutral = 30, negative = 10 }
            };

            await chartModule.InvokeVoidAsync("updateMoodChart", moodData);
        }
    }

    private async Task UpdateWordCountChart(ChangeEventArgs e)
    {
        if (chartModule != null)
        {
            var period = e.Value?.ToString();

            // Static data based on period
            var (labels, data) = period switch
            {
                "7" => (new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" },
                        new[] { 450, 325, 280, 500, 420, 380, 550 }),
                "30" => (new[] { "Week 1", "Week 2", "Week 3", "Week 4" },
                         new[] { 1850, 2100, 1950, 2200 }),
                "120" => (new[] { "Month 1", "Month 2", "Month 3", "Month 4" },
                          new[] { 8500, 9200, 8800, 9500 }),
                _ => (new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" },
                      new[] { 450, 325, 280, 500, 420, 380, 550 })
            };

            await chartModule.InvokeVoidAsync("updateWordCountChart",
                new { labels, data });
        }
    }
}