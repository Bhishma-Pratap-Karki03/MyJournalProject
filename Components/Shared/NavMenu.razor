@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<nav class="sidebar-nav">
    <!-- Dashboard link -->
    <NavLink href="/dashboard" class="nav-item" ActiveClass="active" Match="NavLinkMatch.All">
        <div class="nav-content">
            <img src="images/dashboard-icon.png" alt="Dashboard" class="nav-icon">
            <span class="nav-text">Dashboard</span>
        </div>
    </NavLink>

    <NavLink href="/journal" class="nav-item" ActiveClass="active">
        <div class="nav-content">
            <img src="images/journal-icon.svg" alt="Journal Entries" class="nav-icon">
            <span class="nav-text">Journal Entries</span>
        </div>
    </NavLink>

    <NavLink href="/calendar" class="nav-item" ActiveClass="active">
        <div class="nav-content">
            <img src="images/calendar-nav-icon.svg" alt="Calendar View" class="nav-icon">
            <span class="nav-text">Calendar View</span>
        </div>
    </NavLink>

    <NavLink href="/myjournallist" class="nav-item" ActiveClass="active">
        <div class="nav-content">
            <img src="images/Journal-List-icon.png" alt="My Journal List" class="nav-icon">
            <span class="nav-text">My Journal List</span>
        </div>
    </NavLink>

    <NavLink href="/analytics" class="nav-item" ActiveClass="active">
        <div class="nav-content">
            <img src="images/analytics-icon.svg" alt="Analytics" class="nav-icon">
            <span class="nav-text">Analytics</span>
        </div>
    </NavLink>

    <NavLink href="/export" class="nav-item" ActiveClass="active">
        <div class="nav-content">
            <img src="images/export-icon.svg" alt="Export" class="nav-icon">
            <span class="nav-text">Export</span>
        </div>
    </NavLink>

    <!-- Simple Logout button -->
    <div class="nav-item logout-item" @onclick="Logout">
        <div class="nav-content">
            <img src="images/logout-icon.svg" alt="Logout" class="nav-icon">
            <span class="nav-text">Logout</span>
        </div>
    </div>
</nav>

@code {
    private async Task Logout()
    {
        // Clear user data from localStorage
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "currentUser");

        // Navigate to login page
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}